# Environment Configuration for Render (Frontend + Backend All-in-One)

NODE_ENV=production
MONGODB_URI=your_mongodb_atlas_uri
JWT_SECRET=your_secure_jwt_secret_key

# Cloudinary Storage (Photos, Voice Notes, Media)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_name

# Optional (Render injects PORT automatically)
# PORT=10000
